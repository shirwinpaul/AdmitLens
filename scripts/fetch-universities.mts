/**
 * Downloads the free Hipo/university-domains-list dataset ONCE and splits it into one
 * small JSON file per country under public/data/universities/, so the browser only loads
 * the list for the country the student picked. Also writes src/config/countryList.ts.
 *
 * Run with:  npm run data:universities
 * (Uses Node's built-in TypeScript support — Node 22.18+.)
 */
import { mkdir, readdir, rm, writeFile } from "node:fs/promises";
import path from "node:path";
import { countrySlug, dedupeAndSort, mapDatasetCountry } from "../src/lib/countryMapping.ts";

const SOURCE =
  "https://raw.githubusercontent.com/Hipo/university-domains-list/master/world_universities_and_domains.json";
const ROOT = path.resolve(import.meta.dirname, "..");
const OUT_DIR = path.join(ROOT, "public", "data", "universities");
const COUNTRY_FILE = path.join(ROOT, "src", "config", "countryList.ts");

interface RawUniversity {
  name: string;
  country: string;
  alpha_two_code: string;
}

async function main() {
  console.log("Downloading dataset…");
  const res = await fetch(SOURCE);
  if (!res.ok) throw new Error(`Download failed: HTTP ${res.status}`);
  const data = (await res.json()) as RawUniversity[];

  const byCountry = new Map<string, { code: string; names: string[] }>();
  for (const u of data) {
    if (!u?.name || !u?.country) continue;
    const country = mapDatasetCountry(u.country);
    const entry = byCountry.get(country) ?? { code: u.alpha_two_code ?? "", names: [] };
    entry.names.push(u.name);
    byCountry.set(country, entry);
  }

  await mkdir(OUT_DIR, { recursive: true });
  for (const f of await readdir(OUT_DIR)) {
    if (f.endsWith(".json")) await rm(path.join(OUT_DIR, f));
  }

  const countries: { name: string; code: string; slug: string; count: number }[] = [];
  for (const [name, { code, names }] of byCountry) {
    const list = dedupeAndSort(names);
    const slug = countrySlug(name);
    await writeFile(path.join(OUT_DIR, `${slug}.json`), JSON.stringify(list));
    countries.push({ name, code: code.toUpperCase(), slug, count: list.length });
  }
  countries.sort((a, b) => a.name.localeCompare(b.name, "en"));

  const ts = `// AUTO-GENERATED by scripts/fetch-universities.mts — do not edit by hand.
// Countries that have a university list in public/data/universities/<slug>.json
export interface CountryEntry {
  name: string;
  code: string;
  slug: string;
  count: number;
}

export const COUNTRY_LIST: CountryEntry[] = ${JSON.stringify(countries, null, 2)};
`;
  await writeFile(COUNTRY_FILE, ts);
  console.log(`Done: ${countries.length} countries, ${data.length} raw entries.`);
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
